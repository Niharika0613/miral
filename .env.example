# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/audio

# Backend Configuration (FastAPI)
PORT=8000
HOST=0.0.0.0
DATABASE_URL=postgresql://user:password@localhost:5432/miral_db

# LLM Providers (Choose Ollama for local or OpenAI for cloud)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI API Key (Optional if using cloud Whisper / GPT)
OPENAI_API_KEY=your_openai_api_key_here

# JWT Secret
SECRET_KEY=miral_production_secret_key_change_me
